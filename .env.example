# Copia este archivo como .env.local y completa los valores (no subas .env.local a GitHub).

# --- Backend Supabase (públicos por diseño: la seguridad la dan las políticas RLS) ---
# Supabase → Project Settings → API. Si se dejan vacías, la app funciona en modo demo (datos en memoria).
EXPO_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Nombre del ambiente que muestra la app: desarrollo | pruebas | produccion
EXPO_PUBLIC_APP_ENV=desarrollo

# --- Asistente con IA (solo servidor: src/app/api/chat+api.ts; nunca llegan a la app) ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Proveedor principal: openai o deepseek (si falla, se usa el otro).
CHAT_PROVIDER=openai
# Modelos opcionales
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_MODEL=deepseek-chat

# URL del servidor del asistente para el APK (vacía en desarrollo).
# EXPO_PUBLIC_API_URL=https://tu-proyecto.expo.app

# --- Solo para pruebas automáticas (tests/) ---
# Mismos valores de Supabase; las cuentas de prueba están en supabase/seed.sql.
