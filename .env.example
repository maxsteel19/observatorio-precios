# Copia este archivo como .env.local y completa las claves (no lo subas a GitHub).
# Solo las usa el servidor del asistente (src/app/api/chat+api.ts); nunca llegan a la app.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Proveedor principal: openai o deepseek (si falla, se usa el otro).
CHAT_PROVIDER=openai
# Modelos opcionales
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_MODEL=deepseek-chat

# URL del servidor del asistente para el APK (vacía en desarrollo).
# EXPO_PUBLIC_API_URL=https://tu-proyecto.expo.app
