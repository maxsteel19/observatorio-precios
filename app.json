{
  "expo": {
    "name": "Observatorio de Precios PAC",
    "slug": "observatorio-precios",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "observatorioprecios",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "package": "cl.pac.observatorioprecios",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#124280",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#124280",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fcaec6f1-3f7f-4aac-a3d0-754e627793dc"
      }
    },
    "owner": "observatorio-pac"
  }
}
